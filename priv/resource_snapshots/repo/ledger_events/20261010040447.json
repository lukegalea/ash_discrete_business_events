  "custom_statements": [
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION IF EXISTS bizev_ledger_events_chain_fn() CASCADE;",
      "global?": false,
      "name": "bizev_chain_function",
      "up": "CREATE OR REPLACE FUNCTION bizev_ledger_events_chain_fn() RETURNS trigger AS $fn$\nDECLARE\n  prev text;\nBEGIN\n  SELECT hash INTO prev\n  FROM ledger_events\n  WHERE region = NEW.region\n  ORDER BY sequence DESC\n  LIMIT 1;\n\n  NEW.previous_hash := prev;\n  NEW.hash := encode(sha256(convert_to(concat_ws('|',\n       coalesce(NEW.previous_hash, ''),\n       coalesce(NEW.record_id::text, ''),\n       coalesce(NEW.version::text, ''),\n       coalesce(NEW.occurred_at::text, ''),\n       coalesce(NEW.observed_at::text, ''),\n       coalesce(NEW.resource::text, ''),\n       coalesce(NEW.action::text, ''),\n       coalesce(NEW.action_type::text, ''),\n       coalesce(NEW.subject_type::text, ''),\n       coalesce(NEW.subject_external_id::text, ''),\n       coalesce(NEW.subject_stream::text, ''),\n       coalesce(NEW.actor_type::text, ''),\n       coalesce(NEW.actor_external_id::text, ''),\n       coalesce(NEW.actor_display::text, ''),\n       coalesce(NEW.data::text, ''),\n       coalesce(NEW.context::text, ''),\n       coalesce(NEW.provenance::text, ''),\n       coalesce(NEW.supersedes_event_id::text, ''),\n       coalesce(NEW.delivery_key::text, ''),\n       coalesce(NEW.region::text, ''),\n       coalesce(NEW.residency_tag::text, '')), 'UTF8')), 'hex');\n\n  RETURN NEW;\nEND;\n$fn$ LANGUAGE plpgsql;\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER IF EXISTS bizev_ledger_events_chain ON ledger_events;",
      "global?": false,
      "name": "bizev_chain_trigger",
      "up": "CREATE TRIGGER bizev_ledger_events_chain\n  BEFORE INSERT ON ledger_events\n  FOR EACH ROW EXECUTE FUNCTION bizev_ledger_events_chain_fn();\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION IF EXISTS bizev_ledger_events_immutable_fn() CASCADE;",
      "global?": false,
      "name": "bizev_immutable_function",
      "up": "CREATE OR REPLACE FUNCTION bizev_ledger_events_immutable_fn() RETURNS trigger AS $fn$\nBEGIN\n  RAISE EXCEPTION 'ledger_events is append-only; % is not permitted', TG_OP\n    USING ERRCODE = 'restrict_violation',\n          HINT = 'Correct a wrong entry by recording a new one.';\nEND;\n$fn$ LANGUAGE plpgsql;\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER IF EXISTS bizev_ledger_events_immutable ON ledger_events;",
      "global?": false,
      "name": "bizev_immutable_trigger",
      "up": "CREATE TRIGGER bizev_ledger_events_immutable\n  BEFORE UPDATE OR DELETE ON ledger_events\n  FOR EACH ROW EXECUTE FUNCTION bizev_ledger_events_immutable_fn();\n"
    }
  ],
